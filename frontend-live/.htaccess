# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/ezdguybs9tn4/backend-new/backend-p"
PassengerBaseURI "/api"
PassengerPython "/home/ezdguybs9tn4/virtualenv/backend-new/backend-p/3.11/bin/python"
PassengerAppLogFile "/home/ezdguybs9tn4/logs/passenger.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

Options -MultiViews

RewriteEngine On

# ADMIN LOGIN
RewriteRule ^admin-login/?$ admin-login.html [L]

# OLD SEMINAR URL → NEW SEMINAR PAGE
RewriteRule ^seminar\.html$ /seminar/? [R=302,L]

# SEMINAR STATIC ASSETS
RewriteRule ^seminar/_next/ - [L]
RewriteRule ^seminar/images/ - [L]
RewriteRule ^seminar/videos/ - [L]
RewriteRule ^seminar/404/ - [L]
RewriteRule ^seminar/_not-found/ - [L]

# SEMINAR PAGES
RewriteRule ^seminar/?$ seminar/index.html [L]
RewriteRule ^seminar/register/?$ seminar/register/index.html [L]
RewriteRule ^seminar/privacy-policy/?$ seminar/privacy-policy/index.html [L]
RewriteRule ^seminar/terms-conditions/?$ seminar/terms-conditions/index.html [L]

RewriteBase /

# EXISTING API
RewriteRule ^api(?:/|$) - [L]

# EXISTING FILES AND FOLDERS
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# EXISTING WEBSITE FALLBACK
RewriteRule ^ index.html [L]

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINX ENV VARS CONFIGURATION END