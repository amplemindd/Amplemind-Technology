.sa-dashboard .sa-kpi-active .sa-kpi-icon {
  background: #e1f8ee;
  color: #079b70;
}

.sa-dashboard .sa-kpi-inactive .sa-kpi-icon {
  background: #fff0dc;
  color: #df7900;
}

.sa-dashboard .sa-kpi-other .sa-kpi-icon {
  background: #edf1f7;
  color: #64748b;
}

.sa-dashboard .sa-kpi-label {
  display: block;
  margin-bottom: 5px;
  color: #66758f;
  font-size: 11px;
  font-weight: 700;
}

.sa-dashboard .sa-kpi strong {
  display: block;
  color: #12203d;
  font-size: clamp(26px, 2vw, 33px);
  font-weight: 850;
  line-height: 1.2;
  letter-spacing: -.7px;
  font-variant-numeric: tabular-nums;
}

.sa-dashboard .sa-kpi small {
  display: block;
  margin-top: 6px;
  color: #8490a6;
  font-size: 11px;
  line-height: 1.45;
}

/* Two-by-two chart grid */
.sa-dashboard .sa-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: stretch;
  gap: 15px;
  margin: 0;
}

.sa-dashboard .sa-card {
  min-width: 0;
  min-height: 0;
  padding: 20px;
  background: #fff;
  border: 1px solid #e5eaf5;
  border-radius: 17px;
  box-shadow: 0 4px 15px rgba(29, 45, 85, .035);
  transition: box-shadow .2s ease, transform .2s ease;
}

.sa-dashboard .sa-card:hover {
  box-shadow: 0 9px 23px rgba(29, 45, 85, .065);
}

.sa-dashboard .sa-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0 0 20px;
}

.sa-dashboard .sa-card-heading > div {
  min-width: 0;
}

.sa-dashboard .sa-card-heading h3 {
  margin: 0;
  color: #182542;
  font-size: 16px;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: -.2px;
}

.sa-dashboard .sa-card-heading p {
  margin: 4px 0 0;
  color: #8490a6;
  font-size: 11px;
  font-weight: 400;
  line-height: 1.5;
}

.sa-dashboard .sa-card-icon {
  display: inline-flex;
  flex: 0 0 37px;
  align-items: center;
  justify-content: center;
  width: 37px;
  height: 37px;
  border-radius: 11px;
  background: #f0eeff;
  color: #5545db;
  font-size: 18px;
  font-weight: 800;
}

/* Horizontal distribution bars */
.sa-dashboard .sa-bars {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.sa-dashboard .sa-bar-row {
  min-width: 0;
}

.sa-dashboard .sa-bar-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 7px;
  color: #64738e;
  font-size: 11px;
  line-height: 1.5;
}

.sa-dashboard .sa-bar-label span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.sa-dashboard .sa-bar-label strong {
  flex-shrink: 0;
  color: #182542;
  font-size: 11px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.sa-dashboard .sa-track {
  width: 100%;
  height: 8px;
  overflow: hidden;
  border-radius: 99px;
  background: #edf0f8;
}

.sa-dashboard .sa-bar {
  height: 100%;
  border-radius: inherit;
  transition: width .5s ease;
}

.sa-dashboard .sa-blue {
  background: linear-gradient(90deg, #5b4ce5, #9182ff);
}

.sa-dashboard .sa-green {
  background: linear-gradient(90deg, #08a477, #25d6a0);
}

.sa-dashboard .sa-purple {
  background: linear-gradient(90deg, #8856ec, #b17cff);
}

/* Monthly admissions */
.sa-dashboard .sa-monthly-card {
  grid-column: auto;
}

.sa-dashboard .sa-month-chart {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  gap: 9px;
  min-height: 142px;
  padding: 7px 0 0;
}

.sa-dashboard .sa-month-column {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  min-width: 0;
  color: #7c88a0;
  font-size: 10px;
  text-align: center;
}

.sa-dashboard .sa-month-track {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: min(100%, 42px);
  height: 105px;
  overflow: visible;
  border-radius: 8px 8px 3px 3px;
  background: #f1efff;
}

.sa-dashboard .sa-month-bar {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  min-height: 4px;
  border-radius: 8px 8px 3px 3px;
  background: linear-gradient(180deg, #8c7bff, #5543d6);
  transition: height .5s ease;
}

.sa-dashboard .sa-month-bar span {
  padding-top: 6px;
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.sa-dashboard .sa-month-column > span {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  color: #77849e;
}

.sa-dashboard .sa-empty,
.sa-dashboard .sa-loading {
  color: #8490a6;
  font-size: 12px;
  line-height: 1.7;
}

.sa-dashboard .sa-updated {
  margin: 15px 0 0;
  color: #8a95aa;
  font-size: 10px;
  line-height: 1.6;
}

/* Tablet */
@media (max-width: 1050px) {
  .sa-dashboard .sa-kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Mobile */
@media (max-width: 700px) {
  .sa-dashboard {
    margin-top: 16px;
    padding: 17px;
    border-radius: 17px;
  }

  .sa-dashboard .sa-chart-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .sa-dashboard .sa-card {
    padding: 17px;
  }

  .sa-dashboard .sa-heading {
    align-items: flex-start;
  }
}

@media (max-width: 420px) {
  .sa-dashboard {
    padding: 12px;
  }

  .sa-dashboard .sa-heading h2 {
    font-size: 23px;
  }

  .sa-dashboard .sa-subtitle {
    font-size: 12px;
  }

  .sa-dashboard .sa-refresh {
    width: 100%;
  }

  .sa-dashboard .sa-kpi-grid {
    gap: 9px;
  }

  .sa-dashboard .sa-kpi {
    min-height: 150px;
    padding: 12px;
    border-radius: 13px;
  }

  .sa-dashboard .sa-kpi-icon {
    width: 34px;
    height: 34px;
    margin-bottom: 10px;
  }

  .sa-dashboard .sa-kpi-label,
  .sa-dashboard .sa-kpi small {
    font-size: 10px;
  }

  .sa-dashboard .sa-kpi strong {
    font-size: 26px;
  }

  .sa-dashboard .sa-card-heading h3 {
    font-size: 15px;
  }

  .sa-dashboard .sa-month-chart {
    gap: 5px;
  }

  .sa-dashboard .sa-month-track {
    width: min(100%, 32px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .sa-dashboard *,
  .sa-dashboard *::before,
  .sa-dashboard *::after {
    transition: none !important;
    animation: none !important;
    scroll-behavior: auto !important;
  }
}
