/* Student Analytics Dashboard */
.sa-dashboard {
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 28px;
  padding: 24px;
  color: #172033;
  background: linear-gradient(145deg, #ffffff 0%, #f6f8ff 100%);
  border: 1px solid #e5eaf4;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(30, 50, 90, .07);
  font-family: inherit;
}
.sa-dashboard * { box-sizing: border-box; }
.sa-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}
.sa-eyebrow {
  margin: 0 0 6px;
  color: #635bdb;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.8px;
  text-transform: uppercase;
}
.sa-heading h2 {
  margin: 0;
  color: #172033;
  font-size: clamp(22px, 3vw, 29px);
  font-weight: 800;
  line-height: 1.25;
}
.sa-subtitle {
  margin: 7px 0 0;
  color: #738097;
  font-size: 13px;
  line-height: 1.6;
}
.sa-refresh {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 10px 16px;
  color: #fff;
  background: #5145cd;
  border: 0;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}
.sa-refresh:hover { background: #4035b3; transform: translateY(-1px); }
.sa-refresh:disabled { opacity: .65; cursor: wait; }
.sa-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 20px;
}
.sa-kpi {
  position: relative;
  min-width: 0;
  padding: 19px;
  overflow: hidden;
  background: #fff;
  border: 1px solid #e9edf5;
  border-radius: 15px;
  box-shadow: 0 4px 14px rgba(25, 40, 75, .035);
}
.sa-kpi::after {
  position: absolute;
  right: -20px;
  bottom: -30px;
  width: 85px;
  height: 85px;
  content: "";
  background: currentColor;
  border-radius: 50%;
  opacity: .045;
}
.sa-kpi-total { color: #5145cd; }
.sa-kpi-active { color: #15966a; }
.sa-kpi-inactive { color: #d97706; }
.sa-kpi-other { color: #64748b; }
.sa-kpi-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  margin-bottom: 15px;
  background: currentColor;
  border-radius: 12px;
  font-size: 20px;
}
.sa-kpi-icon span { filter: saturate(.8); }
.sa-kpi-label {
  display: block;
  margin-bottom: 7px;
  color: #778298;
  font-size: 12px;
  font-weight: 600;
}
.sa-kpi-value, .sa-kpi strong {
  display: block;
  color: #172033;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 800;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.sa-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}
.sa-card {
  min-width: 0;
  padding: 21px;
  background: #fff;
  border: 1px solid #e9edf5;
  border-radius: 15px;
  box-shadow: 0 4px 14px rgba(25, 40, 75, .03);
}
.sa-card-heading {
  margin: 0 0 19px;
  color: #202a40;
  font-size: 15px;
  font-weight: 800;
}
.sa-bars { display: flex; flex-direction: column; gap: 17px; }
.sa-bar-row { min-width: 0; }
.sa-bar-label {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  color: #536078;
  font-size: 12px;
  line-height: 1.45;
}
.sa-bar-label span:first-child { overflow-wrap: anywhere; }
.sa-bar-label strong { flex: 0 0 auto; color: #202a40; font-weight: 800; }
.sa-track {
  width: 100%;
  height: 9px;
  overflow: hidden;
  background: #edf0f7;
  border-radius: 99px;
}
.sa-bar {
  height: 100%;
  min-width: 3px;
  border-radius: 99px;
  transition: width .45s ease;
}
.sa-blue { background: linear-gradient(90deg, #6258e8, #8c83ff); }
.sa-green { background: linear-gradient(90deg, #0f9f78, #48d6a7); }
.sa-purple { background: linear-gradient(90deg, #8b5cf6, #bd8bff); }
.sa-monthly-card { grid-column: 1 / -1; }
.sa-month-chart {
  display: flex;
  align-items: stretch;
  gap: 13px;
  min-height: 175px;
  padding-top: 8px;
  overflow-x: auto;
}
.sa-month-column {
  display: flex;
  flex: 1 0 48px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  min-width: 0;
}
.sa-month-bar {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: min(100%, 42px);
  min-height: 5px;
  padding-top: 7px;
  color: #fff;
  background: linear-gradient(180deg, #8d83ff, #5145cd);
  border-radius: 8px 8px 3px 3px;
  font-size: 11px;
  font-weight: 800;
  transition: height .4s ease;
}
.sa-month-track {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: 125px;
}
.sa-month-column > span {
  color: #6f7b91;
  font-size: 11px;
  text-align: center;
  white-space: nowrap;
}
.sa-empty, .sa-loading {
  padding: 25px 12px;
  color: #78849a;
  font-size: 13px;
  text-align: center;
}
.sa-updated {
  margin: 15px 0 0;
  color: #8a94a7;
  font-size: 11px;
  line-height: 1.5;
}
@media (max-width: 900px) {
  .sa-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 620px) {
  .sa-dashboard { padding: 16px; border-radius: 15px; }
  .sa-heading { align-items: flex-start; }
  .sa-refresh { width: 100%; }
  .sa-chart-grid { grid-template-columns: minmax(0, 1fr); }
  .sa-monthly-card { grid-column: auto; }
  .sa-kpi { padding: 15px; }
  .sa-card { padding: 17px; }
}
@media (prefers-reduced-motion: reduce) {
  .sa-dashboard *, .sa-dashboard *::before, .sa-dashboard *::after {
    transition: none !important;
    animation: none !important;
  }
}

